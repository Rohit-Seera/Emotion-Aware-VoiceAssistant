APP_NAME=Weings AI
APP_ENVIRONMENT=development
APP_DEBUG=true

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGE_ME
DATABASE_DATABASE=weings_ai

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=weings-memory
QDRANT_HTTPS=false

SECURITY_JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_64_CHARACTERS_LONG
SECURITY_JWT_ALGORITHM=HS256
SECURITY_JWT_ISSUER=weings-ai
SECURITY_JWT_AUDIENCE=weings-ai-client
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=15
SECURITY_REFRESH_TOKEN_EXPIRE_DAYS=30
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOGIN_LOCKOUT_MINUTES=15
SECURITY_PASSWORD_MIN_LENGTH=12
SECURITY_PASSWORD_MAX_LENGTH=128
SECURITY_REQUIRE_HTTPS=false
SECURITY_REQUIRE_JTI=true
SECURITY_REQUIRE_SECURE_SECRET_IN_PRODUCTION=true
SECURITY_JWT_SECRET_MIN_LENGTH=64

VOICE_MAX_AUDIO_BYTES=10485760
VOICE_MAX_TRANSCRIPT_CHARACTERS=8000
VOICE_TURN_TIMEOUT=75
VOICE_EMOTION_ACOUSTIC_ENABLED=true
VOICE_EMOTION_MODEL=superb/wav2vec2-base-superb-er
VOICE_EMOTION_MIN_CONFIDENCE=0.45
VOICE_EMOTION_PRELOAD=false
VOICE_INTERRUPT_MIN_SPEECH_MS=260
VOICE_INTERRUPT_SILENCE_MS=850

# Optional model provider keys. Leave blank locally until you wire a real provider.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

AI_DEFAULT_PROVIDER=groq
# Speech providers used by the demo
VOICE_STT_PROVIDER=groq
GROQ_STT_MODEL=whisper-large-v3-turbo
VOICE_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Research feature flag
FEATURE_EMOTION=true